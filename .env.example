# sidearm — required secrets and config for docker compose.
# Copy to `.env` and fill in. Never commit the real .env.

# ---- CS2 -----------------------------------------------------------------

# Get one at https://steamcommunity.com/dev/managegameservers (app id 730).
# Rotating this value requires `docker compose up -d --force-recreate cs2`
# because it's passed as a launch argument, not a hot-reloadable cvar.
GSLT=

# Public server password (empty = open server).
SERVER_PASSWORD=

# RCON admin password. Only reachable from the internal docker network.
RCON_PASSWORD=change-me-to-a-long-random-string

# Cosmetic defaults — overridable from the UI once the panel is up.
SERVER_NAME=sidearm

# Hard slot ceiling (`-maxplayers`). It is a launch argument, so the panel
# cannot change it — raising it needs `docker compose up -d --force-recreate cs2`.
#
# There are two numbers here and conflating them is the usual confusion. This
# one is the ceiling the engine allocates at boot. The number players actually
# see is `sv_visiblemaxplayers`, which IS a cvar, changes live, and is set per
# game mode from the panel's Config page.
#
# So set this ONCE, to the largest roster the server will ever host, and let the
# advertised count vary underneath it. A 32-player server running competitive
# advertises 10 of its 33 slots; that is normal, not waste.
#
# GOTV takes one of these slots: with TV_ENABLE=1 the server lists a `CSTV`
# client in slot 0, so 10 here means only nine people can connect and a 5v5 will
# not fit. Always budget one extra.
#
#   5v5 competitive -> 11        2v2 wingman     -> 5
#   16-slot deathmatch -> 17     20-slot casual  -> 21
#   "everything, up to 32 players" -> 33
#
# Higher is not free: the engine reserves memory and edict slots per slot, so do
# not set 64 on a box that will only ever run 5v5.
CS2_MAXPLAYERS=11
CS2_GAMETYPE=0
CS2_GAMEMODE=1
CS2_MAPGROUP=mg_active
CS2_STARTMAP=de_mirage

# ---- GOTV / SourceTV -----------------------------------------------------

# GOTV lets spectators watch and is the only way the panel can record demos
# (`tv_record`). The upstream image ships it disabled; sidearm turns it on.
# These are launch arguments — changing any of them needs
# `docker compose up -d --force-recreate cs2`, so do it while nobody is playing.
TV_ENABLE=1

# Broadcast delay in seconds. 0 means spectators see the game live and can call
# positions, so prefer 30-90 on a server anyone can connect to.
TV_DELAY=30

# Record every match automatically. Demos land in the cs2-data volume.
TV_AUTORECORD=0

# Passwords for spectators and for relay proxies. Empty = open.
TV_PW=
TV_RELAY_PW=

# Spectator bandwidth cap; 0 = unlimited.
TV_MAXRATE=0

# ---- Panel ---------------------------------------------------------------

# Shared secret embedded in the CS2 `logaddress_add_http` URL so the panel
# can reject spoofed log POSTs. Generate with: `openssl rand -hex 24`.
LOG_INGEST_SECRET=change-me

# Bearer token required on /api/* and on the /ws stream. Leave empty to keep
# the panel open on a trusted network. When set, the UI prompts for it once and
# stores an HttpOnly session cookie.
PANEL_ADMIN_TOKEN=

# Comma-separated CIDRs whose clients skip the token entirely — e.g.
# "192.168.1.0/24". Empty (default) means everyone authenticates.
#
# Matched against the real TCP peer address, never against X-Forwarded-For.
# That means it is useless behind a reverse proxy, and actively dangerous if you
# list the proxy's own address: every request would arrive "from" it, exempting
# the whole internet.
PANEL_TRUSTED_CIDRS=

# Set to 1 when serving the panel over HTTPS so the session cookie is marked
# `Secure`. Leave unset for plain-HTTP LAN use, or the cookie is dropped.
PANEL_HTTPS=

# Public address shown in the connect URL. Set this to skip the outbound
# lookup to api.ipify.org on the status poll.
SERVER_IP=

# ---- CS2 updates ---------------------------------------------------------

# The panel asks Steam every CS2_UPDATE_CHECK_MS whether the running build is
# current, and shows an "Update available" button when it is not.
#
# Set CS2_AUTO_UPDATE=1 to also restart the cs2 container automatically — but
# only when nobody is connected. Restarting IS the update: the image runs
# `steamcmd app_update 730` from its entrypoint. Leave unset to always apply
# updates by hand.
CS2_AUTO_UPDATE=

# Check interval in ms (default 15 minutes). Set to 0 to disable the check.
CS2_UPDATE_CHECK_MS=
